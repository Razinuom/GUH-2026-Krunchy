# ---- ElevenLabs voice coach (feature 4) ----
# Values starting with "your-" are treated as unset.
ELEVENLABS_API_KEY=your_api_key
# Filled in by `python -m backend.voice.provision` (or paste an agent id from the ElevenLabs dashboard)
ELEVENLABS_AGENT_ID=your-elevenlabs-agent-id
# Voice, TTS model and LLM. The TTS model must be multilingual (Polish, Malay, Mandarin): eleven_flash_v2_5 is low-latency and covers all three.
ELEVENLABS_VOICE_ID=your-voice-id
ELEVENLABS_TTS_MODEL=eleven_flash_v2_5
ELEVENLABS_LLM=your-llm-id
# Public https URL that reaches this backend, used as the base for webhook tools (e.g. from `ngrok http 8000`)
PUBLIC_BASE_URL=your-public-https-url
# Shared secret ElevenLabs sends in the X-Heirloom-Tool-Secret header on every tool call (make up a long random string)
HEIRLOOM_TOOL_SECRET=your-tool-secret
# HMAC secret for the post-call webhook (ElevenLabs dashboard > Settings > Webhooks)
ELEVENLABS_WEBHOOK_SECRET=your-webhook-secret

# ---- Claim Check (feature 5) ----
# Live search of GOV.UK, MoneyHelper and the FCA (firecrawl.dev). Without it, saved official pages in data/kb are used.
FIRECRAWL_API_KEY=your-firecrawl-api-key

# ---- Demo ----
# Freeze the forecast date so risk levels match the demo script
HEIRLOOM_AS_OF=2026-11-07
